# /etc/sudoers.d/daydream, installed by ops/install-prod.sh (visudo -cf checked).
# Lets the operator (and a Claude Code session running as the operator) start,
# stop and restart exactly the daydream prod units, act as the service user,
# and run the root helper. Every other root action on this box still needs a
# typed password, including changing the helper or this file (the installer).
Cmnd_Alias DAYDREAM_UNITS = \
    /usr/bin/systemctl start daydream-prod.service, \
    /usr/bin/systemctl stop daydream-prod.service, \
    /usr/bin/systemctl restart daydream-prod.service, \
    /usr/bin/systemctl start cloudflared-daydream.service, \
    /usr/bin/systemctl stop cloudflared-daydream.service, \
    /usr/bin/systemctl restart cloudflared-daydream.service, \
    /usr/bin/systemctl start daydream-backup.service
peter ALL=(root) NOPASSWD: DAYDREAM_UNITS
# Dropping to the sandboxed service user is a loss of privilege, never a gain,
# so it needs no password: `bin/game prod` runs every command that touches the
# prod data dir AS daydream, so the operator's own tools never follow a path
# the sandbox could have planted there (SECURITY WARN 2026-09-27).
peter ALL=(daydream) NOPASSWD: ALL
# The root helper (ops/root/daydream-root, docs/ADMIN-ROOT.md): root-owned,
# installed only by ops/install-prod.sh, and it parses its own arguments,
# refusing anything outside a fixed vocabulary: the release's units after its
# validator passes them, the daydream units' start/stop/status, and
# allowlisted prod.env keys after the release's boot guard. Every action it
# takes is logged (journalctl -t daydream-root). Any arguments are allowed
# here on purpose: the helper, not this line, decides what it will do.
peter ALL=(root) NOPASSWD: /usr/local/sbin/daydream-root
