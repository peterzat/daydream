# /srv/daydream/etc/prod.env (root:daydream 0640). Copied here by
# ops/install-prod.sh on first install; edit with sudo. No secrets live here:
# sessions are random tokens in accounts-prod.db, the Access service token
# lives only in the edge Worker, and the tunnel token in /etc/cloudflared.
DAYDREAM_ENV=prod
DAYDREAM_ACCESS=edge
DAYDREAM_PUBLIC_ORIGIN=https://www.eidolon.com
DAYDREAM_PUBLIC_BASE=/daydream/
DAYDREAM_BIND_HOST=127.0.0.1
DAYDREAM_PORT=54322
DAYDREAM_DATA_DIR=/srv/daydream/data
DAYDREAM_OPERATOR_NAME="the Night Warden"
# Engines are the operator's, shared with dev, on loopback.
DAYDREAM_LLM_BASE_URL=http://127.0.0.1:8000/v1
DAYDREAM_COMFYUI_BASE_URL=http://127.0.0.1:8188
# Prod choices: the repaint tool stays admin-only anyway; NPC memory is off
# (the village's voice-sheet dialogue does not use it, and the sandbox has no
# HF cache); the village loop and the journal run.
DAYDREAM_MEMORY_ENABLED=0
