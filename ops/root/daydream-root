RUNUSER = "/usr/sbin/runuser"
ENV_BIN = "/usr/bin/env"
CLEAN_ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8"}

SERVICES = ("daydream-prod.service", "cloudflared-daydream.service", "daydream-backup.service",
            "daydream-keepsakes.service", "daydream-offsite.service")
TIMERS = ("daydream-backup.timer", "daydream-keepsakes.timer", "daydream-offsite.timer")
UNITS = SERVICES + TIMERS
