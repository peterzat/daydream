#!/usr/bin/python3 -I
"""daydream-root: the root actions of daydream prod, as a fixed vocabulary.

Installed by ops/install-prod.sh at /usr/local/sbin/daydream-root (root:root
0755) and reached through one sudoers line:

    <operator> ALL=(root) NOPASSWD: /usr/local/sbin/daydream-root

The design is docs/ADMIN-ROOT.md; the playbook is docs/runbooks/root.md. The
agent reaches it as `bin/game prod root <verb>`.

The rules this program keeps:

- It never runs code from the release or the repo as root. It only reads the
  release's unit files, one path component at a time and never through a
  symlink. The one thing it runs from the release, the boot guard, runs as
  the service user (runuser -u daydream).
- Its fixed facts (the operator, the repo) come from /etc/daydream/root.conf,
  root-owned and written by the installer, never from its arguments or its
  caller's environment. Every command it runs gets a clean environment.
- What it installs is validated first (validate_unit): known units only, a
  per-unit allowlist of keys, each service's identity pinned, and the prod
  sandbox no weaker than the committed unit.
- Every action is logged (journalctl -t daydream-root).

Standard library only; Python 3.10 (the box's /usr/bin/python3).
"""

from __future__ import annotations

import difflib
import grp
import hashlib
import os
import pwd
import re
import stat
import subprocess
import sys

VERSION = "1"

# ---- fixed places ------------------------------------------------------------------
# Module constants, never arguments or environment (the tests point them at a
# scratch tree by patching the module).

SRV = "/srv/daydream"
SYSTEMD_DIR = "/etc/systemd/system"
ROOT_CONF = "/etc/daydream/root.conf"
SUDOERS = "/etc/sudoers.d/daydream"
