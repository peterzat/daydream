# Copy to .env (gitignored) and fill in. bin/game sources .env at startup.
# Anything set here is overridable by ~/.config/daydream/secrets.env (per-host).

# Shared site password. The auth endpoint refuses every login (503) when this
# is unset or empty, so running with no .env at all is a fail-closed state.
DAYDREAM_PASSWORD=

# Network access mode. 'tailscale' (default) lets the AccessMiddleware reject
# any client whose source IP is not in 100.64.0.0/10 (Tailscale CGNAT) or
# loopback. 'public' lets all clients through.
#
# IMPORTANT: setting this to 'public' does NOT also open UFW. The toggle is
# an "agree to be public" flag at the app layer; for traffic to actually
# arrive from the internet you also need:
#   sudo ufw allow ${DAYDREAM_PORT:-54321}/tcp
# and a public DNS pointing at this box's external IP.
DAYDREAM_ACCESS=tailscale

# Session-cookie signing secret. If unset, bin/game / the server generates a
# per-install random secret on first boot and persists it under
# ~/.config/daydream/session_secret (mode 0600). Setting it here pins the value.
# DAYDREAM_SESSION_SECRET=

# Optional: pin the bind port (default 54321 — memorable, non-default for
# modest security-by-obscurity on a user-visible service).
# DAYDREAM_PORT=54321

# Optional: pin the env name (default dev). Multi-env layout lands in v2.
# DAYDREAM_ENV=dev

# Dev room-repaint surface (click the room plate to repaint shared art).
# Default on; set to 0 on any shared deployment so players cannot repaint
# each other's rooms. Off = the endpoints 404 and the SPA hides the tools.
# DAYDREAM_REGEN_UI=1

# Optional: vLLM endpoint and bind. Daydream is the only consumer, so vLLM
# binds 127.0.0.1 by default — set DAYDREAM_VLLM_HOST=0.0.0.0 to expose it
# on the tailnet (e.g., for an external monitoring tool).
# DAYDREAM_LLM_BASE_URL=http://localhost:8000/v1
# DAYDREAM_LLM_MODEL=hosted_vllm/Qwen/Qwen2.5-7B-Instruct-AWQ
# DAYDREAM_VLLM_HOST=127.0.0.1
# DAYDREAM_VLLM_PORT=8000

# Optional: ComfyUI endpoint and bind. Same default rationale; set
# DAYDREAM_COMFYUI_HOST=0.0.0.0 if you want the ComfyUI web UI reachable
# from another tailnet machine (otherwise tunnel via ssh -L 8188:localhost:8188).
# DAYDREAM_COMFYUI_BASE_URL=http://localhost:8188
# DAYDREAM_COMFYUI_HOST=127.0.0.1
# DAYDREAM_COMFYUI_PORT=8188

# ---- generation + gameplay flags -----------------------------------------

# Dream-journal recap on leave (one local-LLM call per "leave the dream").
# Default on; the kill switch for a shared deployment or if recap quality
# ever misses the bar on this hardware.
# DAYDREAM_JOURNAL_ENABLED=1

# Cap on runtime-GROWN rooms per world (dreamseed plants). Counts only grown
# rooms, never authored ones. Propagated child seeds are also suppressed at
# the cap.
# DAYDREAM_GROWTH_MAX_ROOMS=12

# Retell layer: LLM rephrasing of authored rule narrations on repeat
# tellings (retell-enabled worlds only; the authored line always speaks
# first). Kill switch.
# DAYDREAM_RETELL_ENABLED=1

# NPC ambient drift loop + its axes. Cadence in seconds; the LLM branch
# falls back to the canned pools when off/unreachable; mood drift lets a
# tick nudge an NPC's mood bucket.
# DAYDREAM_DRIFT_ENABLED=1
# DAYDREAM_DRIFT_LLM_ENABLED=1
# DAYDREAM_DRIFT_IDLE_SECONDS=300
# DAYDREAM_DRIFT_BUSY_SECONDS=240
# DAYDREAM_DRIFT_MOOD_DRIFT_ENABLED=1
# DAYDREAM_DRIFT_MOOD_DRIFT_PROB=0.2
# DAYDREAM_DRIFT_LLM_TOP_K=3

# NPC dialogue memory (CPU embeddings via bin/memory-bootstrap; fail-closed
# when the embedder is absent). Decay constant for retrieval salience.
# DAYDREAM_MEMORY_ENABLED=1
# DAYDREAM_MEMORY_DECAY_HOURS=24

# ---- GPU / engines --------------------------------------------------------

# Concurrent LLM calls admitted by the in-process arbiter (vLLM batches them
# in its preallocated slice). Must be <= the engine-side cap below.
# DAYDREAM_LLM_CONCURRENCY=3
# DAYDREAM_VLLM_MAX_NUM_SEQS=4
# DAYDREAM_VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# bin/game up's GPU preflight: minimum free VRAM (MiB) before the engines
# are considered launchable. Use `bin/game up --no-gpu` to skip entirely.
# DAYDREAM_GPU_MIN_FREE_MIB=9500

# ---- testing / ops --------------------------------------------------------

# Operational target for bin/game test (staging/prod probes land post-1.0).
# DAYDREAM_TARGET=local

# The optional Zork differential oracle (tier_long): path to a locally-
# supplied story file (never committed) + a seed for the dfrotz replay.
# DAYDREAM_ZORK_ORACLE_STORY=~/data/zork/zork1.z3
# DAYDREAM_ZORK_ORACLE_SEED=4

# Override the build SHA served at /status/build (containers / CI with no
# .git; normally captured from git at boot).
# DAYDREAM_BUILD_SHA=

# Override where persistent state lives (default ~/data/daydream).
# DAYDREAM_DATA_DIR=
