}

case "${1:-}" in
    up)            shift; cmd_up "$@" ;;
    up-all)        shift; cmd_up_all "$@" ;;
    down)          shift; cmd_down "$@" ;;
    deploy)        shift; cmd_deploy "$@" ;;
    status)        shift; cmd_status "$@" ;;
    logs)          shift; cmd_logs "$@" ;;
    image-test)    shift; cmd_image_test "$@" ;;
    comfyui-up)    shift; cmd_comfyui_up "$@" ;;
    comfyui-down)  shift; cmd_comfyui_down "$@" ;;
    vllm-up)       shift; cmd_vllm_up "$@" ;;
    vllm-down)     shift; cmd_vllm_down "$@" ;;
    world)         shift; cmd_world "$@" ;;
    dream)         shift; cmd_dream "$@" ;;
    play)          shift; cmd_play "$@" ;;
    playthrough)   shift; cmd_playthrough "$@" ;;
    prebake)       shift; cmd_prebake "$@" ;;
    test)          shift; cmd_test "$@" ;;
    voice-samples) shift; cmd_voice_samples "$@" ;;
    drift-samples) shift; cmd_drift_samples "$@" ;;
    review)        shift; cmd_review "$@" ;;
    prod)          shift; _require_venv; exec "$VENV_PY" -m daydream.prodctl "$@" ;;
    edge)          shift; _require_venv; exec "$VENV_PY" -m daydream.edge "$@" ;;
    account)       cmd_accounts "$@" ;;
    invite)        cmd_accounts "$@" ;;
    model-eval)    shift; cmd_model_eval "$@" ;;
    text-scan)     shift; _require_venv; exec "$VENV_PY" -m daydream.textscan "$@" ;;
    ci)            shift; _require_venv; exec "$VENV_PY" -m daydream.ci "$@" ;;
    guard)         shift; cmd_guard "$@" ;;
    jev)           shift; _require_venv; exec "$VENV_PY" -m daydream.jev.cli "$@" ;;
    "")            echo "usage: bin/game {up|up-all|deploy|down|status|logs|image-test|comfyui-up|comfyui-down|vllm-up|vllm-down|world|dream|play|playthrough|prebake|account|invite|prod|edge|test|voice-samples|drift-samples|review|model-eval|text-scan|ci|guard|jev}" >&2; exit 2 ;;
    *)             echo "usage: bin/game {up|up-all|deploy|down|status|logs|image-test|comfyui-up|comfyui-down|vllm-up|vllm-down|world|dream|play|playthrough|prebake|account|invite|prod|edge|test|voice-samples|drift-samples|review|model-eval|text-scan|ci|guard|jev} (got: $1)" >&2; exit 2 ;;
esac
