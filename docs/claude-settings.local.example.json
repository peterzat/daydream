{
  "permissions": {
    "allow": [
      "Bash(bin/game prod *)",
      "Bash(bin/game edge *)",
      "Bash(bin/game *)",
      "Bash(bin/install-hooks*)",
      "Bash(.venv/bin/python *)",
      "Bash(.venv/bin/ruff *)",
      "Bash(.venv/bin/pytest *)",
      "Bash(python3 *)",
      "Bash(node *)",
      "Bash(timeout *)",
      "Bash(cd *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sed *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(date*)",
      "Bash(mkdir *)",
      "Bash(diff *)",
      "Bash(cmp *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(jq *)",
      "Bash(sha256sum *)",
      "Bash(stat *)",
      "Bash(which *)",
      "Bash(pgrep *)",
      "Bash(ps *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(nvidia-smi*)",
      "Bash(true)",
      "Bash(test *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git grep *)",
      "Bash(git rev-parse*)",
      "Bash(git check-ignore*)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git stash*)",
      "Bash(git ls-files*)",
      "Bash(git blame *)",
      "Bash(git worktree *)",
      "Bash(git cat-file *)",
      "Bash(git merge-base *)",
      "Bash(git describe*)",
      "Bash(gh run *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list*)"
    ],
    "ask": [
      "Bash(bin/game prod invite create *)",
      "Bash(bin/game prod invite reset *)",
      "Bash(bin/game prod invite revoke *)",
      "Bash(bin/game prod account create *)",
      "Bash(bin/game prod account role *)",
      "Bash(bin/game prod account cli-cookie *)",
      "Bash(bin/game prod account cli-cookie)",
      "Bash(bin/game prod account delete *)",
      "Bash(bin/game prod account disable *)",
      "Bash(bin/game prod account enable *)",
      "Bash(bin/game prod account rename *)",
      "Bash(bin/game prod world reset *)",
      "Bash(bin/game prod world delete *)",
      "Bash(bin/game prod world restore *)",
      "Bash(bin/game prod world snapshot-restore *)",
      "Bash(bin/game prod world restore-backup *)",
      "Bash(bin/game prod world load *)",
      "Bash(bin/game prod root units --apply*)",
      "Bash(bin/game prod root env set *)",
      "Bash(bin/game prod offsite-restore *)",
      "Bash(bin/game edge secrets*)",
      "Bash(bin/game edge kv-create*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/daydream/**)",
      "Read(//srv/daydream/etc/**)",
      "Read(//etc/cloudflared/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.local/share/daydream/guard/agent_guard.py\" 2>/dev/null || echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"the agent guard is not installed: run ! bin/game guard install\"}}'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
