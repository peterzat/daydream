{
  "name": "latecomer",
  "comment": "A second dreamer joining a post-prologue world still gets a complete authored first session (criterion 3): the ledger's pointer, the first winding with Tace, meeting Bell, the Book with Mott.",
  "clock": "2026-10-01T17:00:00+00:00",
  "players": [
    {
      "as": "A",
      "name": "Wren"
    }
  ],
  "segments": [
    {
      "name": "someone else mends the clock",
      "commands": [
        {
          "cmd": "read ledger",
          "expect": {
            "narrate_contains": "escapement gear",
            "beats": [
              "prologue/read-ledger"
            ],
            "phase": "stopped"
          }
        },
        {
          "cmd": "east",
          "expect": {
            "room": "r-square"
          }
        },
        {
          "cmd": "south",
          "expect": {
            "room": "r-well"
          }
        },
        {
          "cmd": "examine ferns",
          "expect": {
            "flag": {
              "GEAR-REVEALED": true
            }
          }
        },
        {
          "cmd": "take gear",
          "expect": {
            "carrying": [
              "escapement gear"
            ],
            "beats": [
              "prologue/found-gear"
            ]
          }
        },
        {
          "cmd": "north"
        },
        {
          "cmd": "west"
        },
        {
          "cmd": "up",
          "expect": {
            "room": "r-loft"
          }
        },
        {
          "cmd": "give gear to tace",
          "expect": {
            "carrying": [
              "case key"
            ],
            "beats": [
              "prologue/gave-gear"
            ],
            "narrate_contains": "You carried it all the way home."
          }
        },
        {
          "cmd": "down",
          "expect": {
            "room": "r-clocktower"
          }
        },
        {
          "cmd": "use key on case",
          "expect": {
            "beats": [
              "prologue/unlocked"
            ]
          }
        },
        {
          "cmd": "open case",
          "expect": {
            "ending": {
              "prologue": "mended"
            },
            "flag": {
              "CLOCK-STARTED": true
            },
            "narrate_contains": "first slow tick",
            "day": {
              "eq": 1
            }
          }
        },
        {
          "cmd": "take dreamseed",
          "expect": {
            "carrying": [
              "dreamseed"
            ]
          }
        },
        {
          "cmd": "take cog",
          "expect": {
            "carrying": [
              "warm brass cog"
            ],
            "arc": {
              "pim": "open"
            },
            "phase": "dusk",
            "located": {
              "t-pims-nap": "r-square"
            }
          }
        }
      ]
    },
    {
      "name": "a newcomer arrives",
      "commands": [
        {
          "clock": "+1h"
        },
        {
          "join": {
            "as": "B",
            "name": "Tamsin"
          }
        },
        {
          "as": "B",
          "cmd": "look",
          "expect": {
            "room": "r-clocktower"
          }
        },
        {
          "as": "B",
          "cmd": "read ledger",
          "expect": {
            "narrate_contains": "ask me about the first winding"
          }
        },
        {
          "as": "B",
          "cmd": "up",
          "expect": {
            "room": "r-loft"
          }
        },
        {
          "as": "B",
          "cmd": "ask tace about the first winding",
          "expect": {
            "carrying": [
              "small clock"
            ],
            "pflag": {
              "GIVEN-CLOCK": true
            },
            "narrate_contains": "every new keeper winds one clock of their own"
          }
        },
        {
          "as": "B",
          "cmd": "wind clock",
          "expect": {
            "pflag": {
              "WOUND": true
            },
            "narrate_contains": "Now there's an hour here that's yours."
          }
        },
        {
          "as": "B",
          "cmd": "down"
        },
        {
          "as": "B",
          "cmd": "east",
          "expect": {
            "room": "r-square"
          }
        },
        {
          "as": "B",
          "cmd": "ask bell about the guests",
          "expect": {
            "narrate_contains": "home"
          }
        },
        {
          "as": "B",
          "cmd": "north",
          "expect": {
            "room": "r-workshop"
          }
        },
        {
          "as": "B",
          "cmd": "ask mott about the book",
          "expect": {
            "pflag": {
              "MET-BOOK": true
            },
            "collected": {
              "gte": 1
            },
            "narrate_contains": "Here's your first."
          }
        },
        {
          "as": "B",
          "cmd": "south"
        },
        {
          "as": "B",
          "cmd": "ask bell about the yawning stranger",
          "expect": {
            "beats": [
              "pim/bell-notices"
            ],
            "narrate_contains": "That one's a nap"
          }
        }
      ]
    }
  ]
}
