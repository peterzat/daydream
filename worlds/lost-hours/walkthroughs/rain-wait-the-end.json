        },
        {
          "cmd": "read letter",
          "expect": {
            "narrate_contains": "isn't yours to open alone",
            "arc": {
              "rain-wait": "open"
            }
          }
        },
        {
          "cmd": "south",
          "expect": {
            "room": "r-lane"
          }
        },
        {
          "cmd": "west",
          "expect": {
            "room": "r-square"
          }
