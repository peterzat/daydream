          }
        },
        {
          "cmd": "take dreamseed",
          "expect": {
            "carrying": [
              "dreamseed",
              "rain-spotted letter"
            ]
          }
        },
        {
          "cmd": "read letter",
          "expect": {
            "narrate_contains": "I hope you had some."
          }
        },
        {
          "cmd": "examine letter",
          "expect": {
            "narrate_contains": "read aloud, once"
          }
        },
        {
          "clock": "+1h",
          "expect": {
            "knows": {
              "t-fen": "rain-wait-the-end"
            },
            "rel": {
              "t-fen": {
                "gte": 3
              }
            },
            "chronicle_contains": "Wren read the Rain-Wait the end of its story, from a letter that was never posted, and it went home dry."
