{
  "name": "extra-hour-everyones",
  "comment": "The Extra Hour, the timed ending: unspent for three days, Umber keeps it in a jar on the lowest shelf of the Hour Cellar, labeled for everyone. Kept, not lost; no fail state.",
  "clock": "2026-10-01T17:00:00+00:00",
  "players": [
    {
      "as": "A",
      "name": "Wren"
    }
  ],
  "segments": [
    {
      "name": "prologue",
      "commands": [
        {
          "cmd": "read ledger",
          "expect": {
            "narrate_contains": "escapement gear",
            "beats": [
              "prologue/read-ledger"
            ],
            "phase": "stopped"
          }
        },
        {
          "cmd": "east",
          "expect": {
            "room": "r-square"
          }
        },
        {
          "cmd": "south",
          "expect": {
            "room": "r-well"
          }
        },
        {
          "cmd": "take gear",
          "expect": {
            "carrying": [
              "escapement gear"
            ],
            "beats": [
              "prologue/found-gear"
            ]
          }
        },
        {
          "cmd": "north"
        },
        {
          "cmd": "west"
        },
        {
          "cmd": "up",
          "expect": {
            "room": "r-loft"
          }
        },
        {
          "cmd": "give gear to tace",
          "expect": {
            "carrying": [
              "case key"
            ],
            "beats": [
              "prologue/gave-gear"
            ],
            "narrate_contains": "You carried it all the way home."
          }
        },
        {
          "cmd": "down",
          "expect": {
            "room": "r-clocktower"
          }
        },
        {
          "cmd": "use key on case",
          "expect": {
            "beats": [
              "prologue/unlocked"
            ]
          }
        },
        {
          "cmd": "open case",
          "expect": {
            "ending": {
              "prologue": "mended"
            },
            "flag": {
              "CLOCK-STARTED": true
            },
            "narrate_contains": "first slow tick",
            "day": {
              "eq": 1
            }
          }
        },
        {
          "cmd": "take dreamseed",
          "expect": {
            "carrying": [
              "dreamseed"
            ]
          }
        },
        {
          "cmd": "take cog",
          "expect": {
            "carrying": [
              "warm brass cog"
            ],
            "arc": {
              "pim": "open"
            },
            "phase": "dusk",
            "located": {
              "t-pims-nap": "r-square"
            }
          }
        }
      ]
    },
    {
      "name": "no one spends it",
      "commands": [
        {
          "summon": "extra-hour",
          "expect": {
            "arc": {
              "extra-hour": "open"
            }
          }
        },
        {
          "clock": "+3d",
          "expect": {
            "arc": {
              "extra-hour": "open"
            },
            "day": {
              "eq": 4
            }
          }
        },
        {
          "clock": "@dusk",
          "expect": {
            "ending": {
              "extra-hour": "everyones"
            },
            "located": {
              "t-extra-hour": "r-cellar"
            },
            "day": {
              "eq": 4
            }
          }
        },
        {
          "cmd": "down",
          "expect": {
            "room": "r-cellar"
          }
        },
        {
          "cmd": "ask extra hour about the jar",
          "expect": {
            "narrate_contains": "Anyone can reach me"
          }
        },
        {
          "cmd": "up"
        },
        {
          "cmd": "read ledger of returned hours",
          "expect": {
            "narrate_contains": "Umber keeps it in a jar on the lowest shelf of the Hour Cellar, labeled for everyone."
          }
        }
      ]
    }
  ]
}
