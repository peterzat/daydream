{
  "name": "tace-hour-another-season",
  "comment": "The Hour Before, the timed ending: Tace hands over the stopped clock, but nobody brings the ladder home. After a week of frosts Tace goes as far as the bottom step of the cellar stair alone, and Umber leaves a cup of tea there. Kept, not lost.",
  "clock": "2026-10-01T17:00:00+00:00",
  "players": [
    {
      "as": "A",
      "name": "Wren"
    }
  ],
  "segments": [
    {
      "name": "prologue",
      "commands": [
        {
          "cmd": "read ledger",
          "expect": {
            "narrate_contains": "escapement gear",
            "beats": [
              "prologue/read-ledger"
            ],
            "phase": "stopped"
          }
        },
        {
          "cmd": "east",
          "expect": {
            "room": "r-square"
          }
        },
        {
          "cmd": "south",
          "expect": {
            "room": "r-well"
          }
        },
        {
          "cmd": "examine ferns",
          "expect": {
            "flag": {
              "GEAR-REVEALED": true
            }
          }
        },
        {
          "cmd": "take gear",
          "expect": {
            "carrying": [
              "escapement gear"
            ],
            "beats": [
              "prologue/found-gear"
            ]
          }
        },
        {
          "cmd": "north"
        },
        {
          "cmd": "west"
        },
        {
          "cmd": "up",
          "expect": {
            "room": "r-loft"
          }
        },
        {
          "cmd": "give gear to tace",
          "expect": {
            "carrying": [
              "case key"
            ],
            "beats": [
              "prologue/gave-gear"
            ],
            "narrate_contains": "You carried it all the way home."
          }
        },
        {
          "cmd": "down",
          "expect": {
            "room": "r-clocktower"
          }
        },
        {
          "cmd": "use key on case",
          "expect": {
            "beats": [
              "prologue/unlocked"
            ]
          }
        },
        {
          "cmd": "open case",
          "expect": {
            "ending": {
              "prologue": "mended"
            },
            "flag": {
              "CLOCK-STARTED": true
            },
            "narrate_contains": "first slow tick",
            "day": {
              "eq": 1
            }
          }
        },
        {
          "cmd": "take dreamseed",
          "expect": {
            "carrying": [
              "dreamseed"
            ]
          }
        },
        {
          "cmd": "take cog",
          "expect": {
            "carrying": [
              "warm brass cog"
            ],
            "arc": {
              "pim": "open"
            },
            "phase": "dusk",
            "located": {
              "t-pims-nap": "r-square"
            }
          }
        }
      ]
    },
    {
      "name": "a new frost",
      "commands": [
        {
          "clock": "+2d",
          "expect": {
            "arc": {
              "tace-hour": "open"
            },
            "day": {
              "eq": 3
            }
          }
        },
        {
          "summon": "tace-hour",
          "expect": {
            "arc": {
              "tace-hour": "open"
            }
          }
        },
        {
          "cmd": "up",
          "expect": {
            "room": "r-loft"
          }
        },
        {
          "cmd": "examine round window",
          "expect": {
            "narrate_contains": "both hands pointing at eleven"
          }
        },
        {
          "cmd": "examine stopped clock",
          "expect": {
            "narrate_contains": "sits apart from the others on the top shelf"
          }
        },
        {
          "cmd": "take stopped clock",
          "expect": {
            "not_carrying": [
              "little brass clock"
            ],
            "narrate_contains": "Not that one, friend"
          }
        },
        {
          "cmd": "ask tace about the frost",
          "expect": {
            "beats": [
              "tace-hour/tace-frost"
            ],
            "carrying": [
              "little brass clock"
            ],
            "narrate_contains": "Umber keeps a lamp lit"
          }
        }
      ]
    },
    {
      "name": "a week of frosts",
      "commands": [
        {
          "clock": "+7d",
          "expect": {
            "arc": {
              "tace-hour": "open"
            },
            "day": {
              "eq": 10
            }
          }
        },
        {
          "clock": "@dusk",
          "expect": {
            "ending": {
              "tace-hour": "another-season"
            },
            "located": {
              "t-tace": "r-loft",
              "o-tace-hour-clock": "r-loft"
            },
            "day": {
              "eq": 10
            }
          }
        },
        {
          "cmd": "examine round window",
          "expect": {
            "narrate_contains": "faint round mark"
          }
        },
        {
          "cmd": "examine stopped clock",
          "expect": {
            "located": {
              "o-tace-hour-clock": "r-loft"
            },
            "not_carrying": [
              "little brass clock"
            ],
            "narrate_contains": "sits apart from the others on the top shelf"
          }
        },
        {
          "cmd": "take stopped clock",
          "expect": {
            "not_carrying": [
              "little brass clock"
            ],
            "narrate_contains": "for another season"
          }
        },
        {
          "cmd": "down",
          "expect": {
            "room": "r-clocktower"
          }
        },
        {
          "cmd": "read ledger of returned hours",
          "expect": {
            "narrate_contains": "This season Tace went as far as the bottom step of the cellar stair, alone"
          }
        }
      ]
    }
  ]
}
