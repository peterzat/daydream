{
  "name": "rain-wait-river",
  "comment": "The Rain-Wait, the timed ending: unhelped for four days, it settles among the reeds at the Slow River's edge, listening to a story that never ends. Kept, not lost; no fail state.",
  "clock": "2026-10-01T17:00:00+00:00",
  "players": [
    {
      "as": "A",
      "name": "Wren"
    }
  ],
  "segments": [
    {
      "name": "prologue",
      "commands": [
        {
          "cmd": "read ledger",
          "expect": {
            "narrate_contains": "escapement gear",
            "beats": [
              "prologue/read-ledger"
            ],
            "phase": "stopped"
          }
        },
        {
          "cmd": "east",
          "expect": {
            "room": "r-square"
          }
        },
        {
          "cmd": "south",
          "expect": {
            "room": "r-well"
          }
        },
        {
          "cmd": "take gear",
          "expect": {
            "carrying": [
              "escapement gear"
            ],
            "beats": [
              "prologue/found-gear"
            ]
          }
        },
        {
          "cmd": "north"
        },
        {
          "cmd": "west"
        },
        {
          "cmd": "up",
          "expect": {
            "room": "r-loft"
          }
        },
        {
          "cmd": "give gear to tace",
          "expect": {
            "carrying": [
              "case key"
            ],
            "beats": [
              "prologue/gave-gear"
            ],
            "narrate_contains": "You carried it all the way home."
          }
        },
        {
          "cmd": "down",
          "expect": {
            "room": "r-clocktower"
          }
        },
        {
          "cmd": "use key on case",
          "expect": {
            "beats": [
              "prologue/unlocked"
            ]
          }
        },
        {
          "cmd": "open case",
          "expect": {
            "ending": {
              "prologue": "mended"
            },
            "flag": {
              "CLOCK-STARTED": true
            },
            "narrate_contains": "first slow tick",
            "day": {
              "eq": 1
            }
          }
        },
        {
          "cmd": "take dreamseed",
          "expect": {
            "carrying": [
              "dreamseed"
            ]
          }
        },
        {
          "cmd": "take cog",
          "expect": {
            "carrying": [
              "warm brass cog"
            ],
            "arc": {
              "pim": "open"
            },
            "phase": "dusk",
            "located": {
              "t-pims-nap": "r-square"
            }
          }
        }
      ]
    },
    {
      "name": "no one finds the end",
      "commands": [
        {
          "summon": "rain-wait",
          "expect": {
            "arc": {
              "rain-wait": "open"
            }
          }
        },
        {
          "clock": "+4d",
          "expect": {
            "arc": {
              "rain-wait": "open"
            },
            "day": {
              "eq": 5
            }
          }
        },
        {
          "clock": "@dusk",
          "expect": {
            "ending": {
              "rain-wait": "river"
            },
            "located": {
              "t-rain-wait": "r-river"
            },
            "day": {
              "eq": 5
            }
          }
        },
        {
          "cmd": "east",
          "expect": {
            "room": "r-square"
          }
        },
        {
          "cmd": "east",
          "expect": {
            "room": "r-lane"
          }
        },
        {
          "cmd": "south",
          "expect": {
            "room": "r-bridge"
          }
        },
        {
          "cmd": "down",
          "expect": {
            "room": "r-river"
          }
        },
        {
          "cmd": "ask rain-wait about the river",
          "expect": {
            "narrate_contains": "It never gets to the end"
          }
        },
        {
          "expect": {
            "chronicle_contains": "listening to a story that never ends, and does not mind."
          }
        }
      ]
    }
  ]
}
