{
  "name": "extra-hour-sat-down",
  "comment": "The Extra Hour, ending sat-down: Bell names it, Tace turns a resting clock back one hour, and the dreamer gives it to Linden, who sits down for the whole of it. Also checks Linden's hint before she has been asked.",
  "clock": "2026-10-01T17:00:00+00:00",
  "players": [
    {
      "as": "A",
      "name": "Wren"
    }
  ],
  "segments": [
    {
      "name": "prologue",
      "commands": [
        {
          "cmd": "read ledger",
          "expect": {
            "narrate_contains": "escapement gear",
            "beats": [
              "prologue/read-ledger"
            ],
            "phase": "stopped"
          }
        },
        {
          "cmd": "east",
          "expect": {
            "room": "r-square"
          }
        },
        {
          "cmd": "south",
          "expect": {
            "room": "r-well"
          }
        },
        {
          "cmd": "take gear",
          "expect": {
            "carrying": [
              "escapement gear"
            ],
            "beats": [
              "prologue/found-gear"
            ]
          }
        },
        {
          "cmd": "north"
        },
        {
          "cmd": "west"
        },
        {
          "cmd": "up",
          "expect": {
            "room": "r-loft"
          }
        },
        {
          "cmd": "give gear to tace",
          "expect": {
            "carrying": [
              "case key"
            ],
            "beats": [
              "prologue/gave-gear"
            ],
            "narrate_contains": "You carried it all the way home."
          }
        },
        {
          "cmd": "down",
          "expect": {
            "room": "r-clocktower"
          }
        },
        {
          "cmd": "use key on case",
          "expect": {
            "beats": [
              "prologue/unlocked"
            ]
          }
        },
        {
          "cmd": "open case",
          "expect": {
            "ending": {
              "prologue": "mended"
            },
            "flag": {
              "CLOCK-STARTED": true
            },
            "narrate_contains": "first slow tick",
            "day": {
              "eq": 1
            }
          }
        },
        {
          "cmd": "take dreamseed",
          "expect": {
            "carrying": [
              "dreamseed"
            ]
          }
        },
        {
          "cmd": "take cog",
          "expect": {
            "carrying": [
              "warm brass cog"
            ],
            "arc": {
              "pim": "open"
            },
            "phase": "dusk",
            "located": {
              "t-pims-nap": "r-square"
            }
          }
        }
      ]
    },
    {
      "name": "the hour with two shadows",
      "commands": [
        {
          "summon": "extra-hour",
          "expect": {
            "arc": {
              "extra-hour": "open"
            },
            "located": {
              "t-extra-hour": "r-square"
            }
          }
        },
        {
          "cmd": "east",
          "expect": {
            "room": "r-square"
          }
        },
        {
          "cmd": "ask bell about the hour with two shadows",
          "expect": {
            "beats": [
              "extra-hour/bell-shadows"
            ],
            "narrate_contains": "Two shadows!"
          }
        },
        {
          "cmd": "ask extra hour about the night the clocks went back",
          "expect": {
            "beats": [
              "extra-hour/hear-autumn"
            ],
            "narrate_contains": "on purpose"
          }
        },
        {
          "cmd": "ask extra hour about the two shadows",
          "expect": {
            "narrate_contains": "Extra Hour"
          }
        }
      ]
    },
    {
      "name": "a clock turned back",
      "commands": [
        {
          "cmd": "west"
        },
        {
          "cmd": "up",
          "expect": {
            "room": "r-loft"
          }
        },
        {
          "cmd": "ask tace about turning the clocks back",
          "expect": {
            "beats": [
              "extra-hour/tace-turnback"
            ],
            "carrying": [
              "turned-back clock"
            ],
            "narrate_contains": "Wind it where you mean to spend it"
          }
        }
      ]
    },
    {
      "name": "someone who never sits down",
      "commands": [
        {
          "cmd": "down"
        },
        {
          "cmd": "east",
          "expect": {
            "room": "r-square"
          }
        },
        {
          "cmd": "east",
          "expect": {
            "room": "r-lane"
          }
        },
        {
          "cmd": "east",
          "expect": {
            "room": "r-waiting"
          }
        },
        {
          "cmd": "give turned-back clock to linden",
          "expect": {
            "narrate_contains": "when I'm sitting down",
            "carrying": [
              "turned-back clock"
            ],
            "arc": {
              "extra-hour": "open"
            }
          }
        },
        {
          "cmd": "ask linden",
          "expect": {
            "narrate_contains": "sitting down"
          }
        },
        {
          "cmd": "ask linden about sitting down",
          "expect": {
            "beats": [
              "extra-hour/linden-sit"
            ],
            "narrate_contains": "wasn't anybody's"
          }
        },
        {
          "cmd": "give turned-back clock to linden",
          "expect": {
            "ending": {
              "extra-hour": "sat-down"
            },
            "carrying": [
              "cold teacup"
            ],
            "not_carrying": [
              "turned-back clock"
            ],
            "located": {
              "t-extra-hour": null,
              "o-extra-hour-clock": "t-linden"
            },
            "collected": {
              "gte": 1
            },
            "narrate_contains": "Stone cold",
            "knows": {
              "t-linden": "extra-hour-sat-down"
            }
          }
        },
        {
          "clock": "+1h",
          "expect": {
            "knows": {
              "t-bell": "extra-hour-sat-down"
            }
          }
        },
        {
          "cmd": "west"
        },
        {
          "cmd": "west"
        },
        {
          "cmd": "west",
          "expect": {
            "room": "r-clocktower"
          }
        },
        {
          "cmd": "read ledger of returned hours",
          "expect": {
            "narrate_contains": "Wren gave the Extra Hour to Linden, who sat down for the whole of it, on purpose."
          }
        }
      ]
    }
  ]
}
